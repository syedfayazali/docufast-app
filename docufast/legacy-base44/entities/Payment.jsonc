{
  "name": "Payment",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "application_ref": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "government_fee": {
      "type": "number",
      "default": 0
    },
    "service_charge": {
      "type": "number",
      "default": 0
    },
    "other_charges": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Paid",
        "Failed",
        "Refunded"
      ],
      "default": "Pending"
    },
    "utr": {
      "type": "string",
      "description": "UPI/bank transaction reference number submitted by the customer as payment proof"
    },
    "payment_proof_uri": {
      "type": "string",
      "description": "Private file URI of the uploaded payment screenshot"
    }
  },
  "required": [
    "reference",
    "application_ref",
    "customer_name",
    "total",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}