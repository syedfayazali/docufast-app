{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "lucide-react icon name"
    },
    "government_fee": {
      "type": "number"
    },
    "service_charge": {
      "type": "number"
    },
    "other_charges": {
      "type": "number",
      "default": 0
    },
    "processing_info": {
      "type": "string"
    },
    "appointment_required": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligibility": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "short_description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}