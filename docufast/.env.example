# ---- Frontend (safe to expose; prefixed VITE_) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ---- Server only (Vercel serverless functions in /api). NEVER prefix with VITE_ ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
# Razorpay (Dashboard -> Account & Settings -> API Keys). rzp_test_ = test mode, rzp_live_ = live mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# optional: webhook secret (Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Optional: your public site URL (used for the post-payment return link)
# SITE_URL=https://your-site.vercel.app

# Appointment e-mails (Brevo -> SMTP & API -> API Keys). MAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=xkeysib-xxxxxxxx
MAIL_FROM=DocuFast India <bookings@yourdomain.com>
# Optional: get a copy of every booking/cancellation, reply-to address, phone printed in e-mails
# MAIL_ADMIN_COPY=you@yourdomain.com
# MAIL_REPLY_TO=support@yourdomain.com
# SUPPORT_PHONE=8374968022
