# ---- Frontend (safe to expose; prefixed VITE_) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ---- Server only (Vercel serverless functions in /api). NEVER prefix with VITE_ ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
# Razorpay (Dashboard -> Account & Settings -> API Keys). rzp_test_* => test mode, rzp_live_* => live mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard -> Account & Settings -> Webhooks: the secret you type when adding the webhook
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Optional: your public site URL 
# SITE_URL=https://your-site.vercel.app
